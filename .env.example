# Environment configuration template for Atlas Open Capsule

# --- Gemini & AI Model Configuration ---
GEMINI_API_KEY="your-gemini-api-key"
AGENT_MODEL="gemini-2.5-flash-lite"

# --- Capsule Runtime Settings ---
PORT=8080
APP_DATA_DIR="/tmp/atlas_brain"
POLL_INTERVAL_SECONDS=10
CHAT_LOOKBACK_MINUTES=360
DEFAULT_CHAT_SPACE=""

# --- Administrative Access & Security ---
ADMIN_DEFAULT_USERNAME="admin"
ADMIN_DEFAULT_PASSWORD="changeme_capsule_secret_123!"
DEFAULT_ADMIN_EMAIL="admin@example.com"

# --- Google OAuth Credentials (Gmail, Chat, Calendar) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REFRESH_TOKEN=""

# --- Persistence (Cloud SQL / MySQL) ---
# For local MySQL: mysql+pymysql://user:pass@localhost:3306/atlas_capsule
# For Cloud SQL: use Cloud SQL Auth Proxy or DB_* environment variables
DB_USER="atlas_user"
DB_PASS="atlas_pass"
DB_NAME="atlas_capsule"
DB_HOST="127.0.0.1"
DB_PORT="3306"

# --- Google Cloud Storage (Memory Sync) ---
GCS_BUCKET_NAME=""
